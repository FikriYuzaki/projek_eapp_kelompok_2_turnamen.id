# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/
ENV/

# Environment variables & secrets (NEVER commit real credentials)
.env
.env.local
.env.*.local
*.pem
*.key

# Distribution / packaging
build/
dist/
*.egg-info/
.eggs/

# Pytest / Coverage
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# Logs and local runtime data
logs/
*.log
*.pid
*.sqlite3
*.db

# IDE / Editor specific
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
Thumbs.db
.DS_Store
Desktop.ini

# Node temporary caches (if npx is run locally)
node_modules/

# NOTE: .agents/skills/ and skills-lock.json are intentionally tracked in Git
# so all 5 team members share identical project-level AI Agent Skills.
!.agents/
!.agents/skills/
!skills-lock.json

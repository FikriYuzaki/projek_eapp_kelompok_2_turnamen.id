# ============================================================================
# TURNAMEN.IN - ENVIRONMENT CONFIGURATION EXAMPLE
# Salin file ini menjadi `.env` untuk penggunaan lokal:
#   copy .env.example .env
# JANGAN PERNAH menyimpan secret asli, password, JWT pengguna, atau
# secret/service_role key ke repository Git maupun distribusi aplikasi desktop!
# ============================================================================

# Application Mode: "mock" (default untuk pengembangan offline/paralel) atau "supabase"
APP_MODE=mock
APP_ENV=development
APP_NAME=Turnamen.in
APP_VERSION=0.1.0

# Flask Local REST API Server (Tetap gunakan 127.0.0.1 untuk keamanan lokal)
API_HOST=127.0.0.1
API_PORT=5000
FLASK_DEBUG=false
SECRET_KEY=replace-with-local-random-dev-secret-key-min-32-chars

# Python Eel Desktop Window Configuration
EEL_HOST=127.0.0.1
EEL_PORT=8080
EEL_BROWSER_MODE=chrome
EEL_START_PAGE=index.html
EEL_WINDOW_WIDTH=1366
EEL_WINDOW_HEIGHT=820

# Supabase Configuration (Hanya wajib diisi jika APP_MODE=supabase)
# - Publishable key (`sb_publishable_...`) aman digunakan pada aplikasi desktop
#   karena akses data tetap dibatasi oleh sesi Supabase Auth pengguna dan
#   kebijakan Row Level Security (RLS) di PostgreSQL.
# - DILARANG KERAS menyertakan secret key (`sb_secret_...`) atau legacy
#   `service_role` key pada aplikasi desktop karena key tersebut melewati RLS.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
# [DEPRECATED - Fallback Kompatibilitas] Gunakan hanya jika proyek belum memakai
# SUPABASE_PUBLISHABLE_KEY. Jangan mengisi nilai berbeda pada kedua variabel.
# SUPABASE_ANON_KEY=your-legacy-supabase-anon-jwt
# Bucket opsional untuk aset turnamen umum di masa depan (tidak dipakai oleh alur
# poster game; Wave 6.11 memakai konstanta GAME_ARTWORK_BUCKET="game-artwork").
SUPABASE_STORAGE_BUCKET=tournament-assets

# Optional External Game Metadata (RAWG API - Opsional, sistem tetap jalan tanpanya)
RAWG_API_KEY=
RAWG_API_BASE_URL=https://api.rawg.io/api

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/turnamen_in.log

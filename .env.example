# ============================================================================
# TURNAMEN.IN — ENVIRONMENT CONFIGURATION EXAMPLE
# Salin file ini menjadi `.env` untuk penggunaan lokal:
#   copy .env.example .env
# JANGAN PERNAH menyimpan secret asli atau service_role key ke Git!
# ============================================================================

# Application Mode: "mock" (default untuk pengembangan offline/paralel) atau "supabase"
APP_MODE=mock
APP_ENV=development
APP_NAME=Turnamen.in
APP_VERSION=0.1.0

# Flask Local REST API Server (Tetap gunakan 127.0.0.1 untuk keamanan lokal)
API_HOST=127.0.0.1
API_PORT=5000
FLASK_DEBUG=false
SECRET_KEY=replace-with-local-random-dev-secret-key-min-32-chars

# Python Eel Desktop Window Configuration
EEL_HOST=127.0.0.1
EEL_PORT=8080
EEL_BROWSER_MODE=chrome
EEL_START_PAGE=index.html
EEL_WINDOW_WIDTH=1366
EEL_WINDOW_HEIGHT=820

# Supabase Configuration (Hanya wajib diisi jika APP_MODE=supabase)
# Gunakan anon/publishable key bersama autentikasi pengguna dan RLS.
# JANGAN PERNAH menaruh service_role key pada distribusi aplikasi desktop/frontend!
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key
SUPABASE_STORAGE_BUCKET=tournament-assets

# Optional External Game Metadata (RAWG API - Opsional, sistem tetap jalan tanpanya)
RAWG_API_KEY=
RAWG_API_BASE_URL=https://api.rawg.io/api

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/turnamen_in.log
